{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-os.invalid/schemas/role-pack-v1.json",
  "title": "Rolevane role pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "version",
    "label",
    "provenance",
    "compatibility",
    "fallback",
    "confidence_cap",
    "application_readiness_allowed",
    "structural_meaning",
    "taxonomy",
    "selection",
    "requirements",
    "misleading_patterns",
    "economics_questions",
    "diligence_prompts",
    "application_archetypes",
    "dimension_weights",
    "bounded_adjustments"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "pack_id": {
      "enum": [
        "commercial_leadership",
        "customer_post_sales_leadership",
        "generic_fallback",
        "product_leadership",
        "senior_expert_ic",
        "services_solutions_leadership"
      ]
    },
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "label": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "reviewed_on", "source"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "reviewed_on": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_contract", "replaces"],
      "properties": {
        "engine_contract": {"const": 1},
        "replaces": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "fallback": {"type": "boolean"},
    "confidence_cap": {"type": "number", "minimum": 0, "maximum": 1},
    "application_readiness_allowed": {"type": "boolean"},
    "structural_meaning": {"type": "string", "minLength": 1},
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_family", "title_patterns", "mandate_archetypes", "adjacent_archetypes"],
      "properties": {
        "role_family": {"type": "string"},
        "title_patterns": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "mandate_archetypes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "adjacent_archetypes": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "trigger_signals", "explanation"],
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string"},
              "trigger_signals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
              "explanation": {"type": "string"}
            }
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_signals", "supporting_signals", "disqualifying_signals"],
      "properties": {
        "required_signals": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "supporting_signals": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "disqualifying_signals": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "level", "impact", "statement", "evidence_question"],
        "properties": {
          "id": {"type": "string"},
          "level": {"enum": ["mandatory", "preferred", "optional"]},
          "impact": {"enum": ["hard_gate", "stretch", "evidence"]},
          "statement": {"type": "string"},
          "evidence_question": {"type": "string"}
        }
      }
    },
    "misleading_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "caution"],
        "properties": {"pattern": {"type": "string"}, "caution": {"type": "string"}}
      }
    },
    "economics_questions": {"type": "array", "items": {"type": "string"}},
    "diligence_prompts": {"type": "array", "items": {"type": "string"}},
    "application_archetypes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "dimension_weights": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "bounded_adjustments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "minimum", "maximum", "reason"],
        "properties": {
          "id": {"type": "string"},
          "minimum": {"type": "number"},
          "maximum": {"type": "number"},
          "reason": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"fallback": {"const": true}}},
      "then": {
        "properties": {
          "application_readiness_allowed": {"const": false},
          "confidence_cap": {"maximum": 0.5},
          "selection": {
            "properties": {
              "required_signals": {"maxItems": 0},
              "supporting_signals": {"maxItems": 0},
              "disqualifying_signals": {"maxItems": 0}
            }
          },
          "requirements": {"maxItems": 0},
          "dimension_weights": {"maxProperties": 0}
        }
      },
      "else": {
        "properties": {
          "selection": {
            "properties": {
              "required_signals": {"minItems": 1}
            }
          },
          "requirements": {
            "minItems": 1,
            "contains": {
              "type": "object",
              "properties": {
                "level": {"const": "mandatory"},
                "impact": {"const": "hard_gate"}
              },
              "required": ["level", "impact"]
            }
          },
          "dimension_weights": {"minProperties": 1}
        }
      }
    }
  ]
}
